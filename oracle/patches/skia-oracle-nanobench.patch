+// skia-rust oracle: raw output dump, same layout and metadata as dm/OracleDump.cpp. Test tooling
+// only.
+static void oracle_mkdirs(const SkString& dir) {
+    for (size_t i = 1; i <= (size_t)dir.size(); i++) {
+        if (i == (size_t)dir.size() || dir.c_str()[i] == '/') {
+            SkString prefix(dir.c_str(), i);
+            sk_mkdir(prefix.c_str());
+        }
+    }
+}
+
+static const char* oracle_cpu_tier() {
+#if defined(SK_CPU_X86)
+    if (SkCpu::Supports(SkX64::ML4)) { return "ml4"; }
+    if (SkCpu::Supports(SkX64::ML3)) { return "ml3"; }
+    if (SkCpu::Supports(SkX64::SSSE3)) { return "ssse3"; }
+    return "baseline";
+#elif defined(SK_CPU_ARM64)
+    return "neon";
+#else
+    return "baseline";
+#endif
+}
+
+static void oracle_dump(Target* target, const char* config, const char* name) {
+    SkBitmap bmp;
+    if (target->getCanvas() &&
+        kUnknown_SkColorType == target->getCanvas()->imageInfo().colorType()) {
+        return;
+    }
+    if (!target->capturePixels(&bmp)) {
+        return;
+    }
+    SkString dir = SkOSPath::Join(FLAGS_oracleRawPath[0], config);
+    dir = SkOSPath::Join(dir.c_str(), "bench");
+    SkString base = SkOSPath::Join(dir.c_str(), name);
+    oracle_mkdirs(SkOSPath::Dirname(base.c_str()));
+
+    const SkImageInfo& info = bmp.info();
+    SkDynamicMemoryWStream pixels;
+    for (int y = 0; y < info.height(); ++y) {
+        pixels.write(bmp.getAddr(0, y), info.minRowBytes());
+    }
+    sk_sp<SkData> bytes = pixels.detachAsData();
+    SkFILEWStream raw(SkStringPrintf("%s.raw", base.c_str()).c_str());
+    SkString meta;
+    meta.appendf("{\n  \"sink\": \"%s\",\n  \"src\": \"bench\",\n  \"name\": \"%s\",\n",
+                 config, name);
+    const char* cap = getenv("SKIA_ORACLE_CPU_CAP");
+    meta.appendf("  \"cpu_cap\": \"%s\",\n  \"cpu_tier\": \"%s\",\n", cap ? cap : "",
+                 oracle_cpu_tier());
+    meta.appendf("  \"kind\": \"pixels\",\n  \"width\": %d,\n  \"height\": %d,\n",
+                 info.width(), info.height());
+    meta.appendf("  \"color_type\": \"%s\",\n  \"alpha_type\": \"%s\"\n}\n",
+                 ToolUtils::colortype_name(info.colorType()),
+                 ToolUtils::alphatype_name(info.alphaType()));
+    SkFILEWStream json(SkStringPrintf("%s.json", base.c_str()).c_str());
+    if (!raw.isValid() || !json.isValid() || !raw.write(bytes->data(), bytes->size()) ||
+        !json.write(meta.c_str(), meta.size())) {
+        SkDebugf("OracleDump: failed to write %s\n", base.c_str());
+        abort();
+    }
+}
