diff --git a/src/core/SkCpu.cpp b/src/core/SkCpu.cpp
index 07afa2d..801af92 100644
--- a/src/core/SkCpu.cpp
+++ b/src/core/SkCpu.cpp
@@ -24,6 +24,10 @@
 #include "include/private/SkFeatures.h"
 #include "include/private/SkOnce.h"
 
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
 #if defined(SK_CPU_X86)
     #if defined(_MSC_VER)
         #include <intrin.h>
@@ -230,7 +234,30 @@ namespace {
 
 uint32_t SkCpu::gCachedFeatures = 0;
 
+// skia-rust oracle: SKIA_ORACLE_CPU_CAP=baseline|ssse3|ml3|ml4 hides runtime CPU features above
+// that level, so one binary can produce the output of every runtime SkOpts tier. "baseline"
+// leaves only what the build's compile-time level guarantees (SkCpu::Supports ORs those back in).
+// Test tooling only.
+static uint32_t skia_oracle_cap_features(uint32_t features) {
+    const char* cap = getenv("SKIA_ORACLE_CPU_CAP");
+    if (!cap || !*cap) {
+        return features;
+    }
+    if (0 == strcmp(cap, "baseline")) { return 0; }
+#if defined(SK_CPU_X86)
+    constexpr uint32_t kAboveML3 = SkX64::AVX512F | SkX64::AVX512DQ | SkX64::AVX512IFMA |
+                                   SkX64::AVX512PF | SkX64::AVX512ER | SkX64::AVX512CD |
+                                   SkX64::AVX512BW | SkX64::AVX512VL;
+    constexpr uint32_t kUpToSSSE3 = SkX64::SSE1 | SkX64::SSE2 | SkX64::SSE3 | SkX64::SSSE3;
+    if (0 == strcmp(cap, "ssse3")) { return features & kUpToSSSE3; }
+    if (0 == strcmp(cap, "ml3"))   { return features & ~kAboveML3; }
+    if (0 == strcmp(cap, "ml4"))   { return features; }
+#endif
+    fprintf(stderr, "SKIA_ORACLE_CPU_CAP: unknown value '%s'\n", cap);
+    abort();
+}
+
 void SkCpu::CacheRuntimeFeatures() {
     static SkOnce once;
-    once([] { gCachedFeatures = read_cpu_features(); });
+    once([] { gCachedFeatures = skia_oracle_cap_features(read_cpu_features()); });
 }
