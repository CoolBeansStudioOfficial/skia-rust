 using namespace skia_private;
 using Op = SkRasterPipelineOp;
@@ -621,13 +626,111 @@
     }
 }
 
+// skia-rust oracle: SKIA_ORACLE_RP_DUMP=<file> appends one record per pipeline build (every
+// run() and compile()): `<result id> <highp|lowp> <op> <op> ...` followed by `# <index> <op> <ctx>`
+// lines carrying the values of the contexts that matter for exactness. The result id is set by
+// DM per task (see SkOracleSetResultId). Test tooling only.
+static thread_local char gOracleResultId[512] = "";
+
+void SkOracleSetResultId(const char* id);
+void SkOracleSetResultId(const char* id) {
+    snprintf(gOracleResultId, sizeof(gOracleResultId), "%s", id ? id : "");
+}
+
+static void oracle_dump_floats(std::string* out, const float* f, int n) {
+    for (int i = 0; i < n; i++) {
+        char buf[32];
+        snprintf(buf, sizeof(buf), i ? " %.9g" : "%.9g", f[i]);
+        out->append(buf);
+    }
+}
+
+static void oracle_dump_pipeline(const SkRasterPipeline::StageList* fStages, bool lowp) {
+    static const char* path = getenv("SKIA_ORACLE_RP_DUMP");
+    if (!path || !*path) {
+        return;
+    }
+    std::vector<const SkRasterPipeline::StageList*> stages;
+    for (auto st = fStages; st; st = st->prev) {
+        stages.push_back(st);
+    }
+    std::reverse(stages.begin(), stages.end());
+
+    std::string text = gOracleResultId[0] ? gOracleResultId : "-";
+    text += lowp ? " lowp" : " highp";
+    for (auto st : stages) {
+        text += ' ';
+        text += SkRasterPipeline::GetOpName(st->stage);
+    }
+    text += '\n';
+    for (size_t i = 0; i < stages.size(); i++) {
+        using Op = SkRasterPipelineOp;
+        const auto* st = stages[i];
+        std::string c;
+        switch (st->stage) {
+            case Op::uniform_color:
+            case Op::uniform_color_dst: {
+                auto* u = (const SkRasterPipelineContexts::UniformColorCtx*)st->ctx;
+                oracle_dump_floats(&c, &u->r, 4);
+                char buf[64];
+                snprintf(buf, sizeof(buf), " | %u %u %u %u", u->rgba[0], u->rgba[1], u->rgba[2],
+                         u->rgba[3]);
+                c += buf;
+                break;
+            }
+            case Op::set_rgb:
+            case Op::unbounded_set_rgb:   oracle_dump_floats(&c, (const float*)st->ctx, 3); break;
+            case Op::matrix_translate:    oracle_dump_floats(&c, (const float*)st->ctx, 2); break;
+            case Op::matrix_scale_translate:
+                                          oracle_dump_floats(&c, (const float*)st->ctx, 4); break;
+            case Op::matrix_2x3:          oracle_dump_floats(&c, (const float*)st->ctx, 6); break;
+            case Op::matrix_3x3:
+            case Op::matrix_perspective:  oracle_dump_floats(&c, (const float*)st->ctx, 9); break;
+            case Op::matrix_3x4:
+            case Op::matrix_4x3:          oracle_dump_floats(&c, (const float*)st->ctx, 12); break;
+            case Op::matrix_4x5:          oracle_dump_floats(&c, (const float*)st->ctx, 20); break;
+            case Op::parametric:          oracle_dump_floats(&c, (const float*)st->ctx, 7); break;
+            case Op::gamma_:              oracle_dump_floats(&c, (const float*)st->ctx, 1); break;
+            case Op::evenly_spaced_2_stop_gradient: {
+                auto* g = (const SkRasterPipelineContexts::EvenlySpaced2StopGradientCtx*)st->ctx;
+                oracle_dump_floats(&c, g->factor, 4);
+                c += " |";
+                c += ' ';
+                oracle_dump_floats(&c, g->bias, 4);
+                break;
+            }
+            case Op::gradient:
+            case Op::evenly_spaced_gradient: {
+                auto* g = (const SkRasterPipelineContexts::GradientCtx*)st->ctx;
+                char buf[64];
+                snprintf(buf, sizeof(buf), "stops=%zu", g->stopCount);
+                c += buf;
+                break;
+            }
+            default: break;
+        }
+        if (!c.empty()) {
+            text += "# " + std::to_string(i) + " " + SkRasterPipeline::GetOpName(st->stage) +
+                    " " + c + "\n";
+        }
+    }
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    if (FILE* f = fopen(path, "ab")) {
+        fwrite(text.data(), 1, text.size(), f);
+        fclose(f);
+    }
+}
+
 SkRasterPipeline::StartPipelineFn SkRasterPipeline::buildPipeline(SkRasterPipelineStage* ip) const {
     // We try to build a lowp pipeline first; if that fails, we fall back to a highp float pipeline.
     if (this->buildLowpPipeline(ip)) {
+        oracle_dump_pipeline(fStages, /*lowp=*/true);
         return SkOpts::start_pipeline_lowp;
     }
 
     this->buildHighpPipeline(ip);
+    oracle_dump_pipeline(fStages, /*lowp=*/false);
     return SkOpts::start_pipeline_highp;
 }
 
